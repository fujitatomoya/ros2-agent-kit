{
  "id": "app",
  "description": "The user's own ROS 2 application or workspace. Style, lint, and tests on; authorship rules off; DCO optional.",
  "applies_to": {
    "remotes": [],
    "detect": "default"
  },
  "sources": [
    "ros2-developer-guide"
  ],
  "rules": {
    "dco": {
      "required": false,
      "signoff_must_match_author": true,
      "forbid_agent_identity": false
    },
    "ai_disclosure": {
      "pull_request": "optional",
      "issue": "optional",
      "commit_trailer": "optional",
      "trailer_format": "Assisted-by: {agent}:{model} [{tools}]"
    },
    "authorship": {
      "pr_description": "any",
      "issue_body": "any",
      "discussion_replies": "any",
      "agent_submission": "allow",
      "agent_discussion": "allow"
    },
    "hooks": {
      "allow_bypass": false
    },
    "branching": {
      "target": null,
      "backport_title": null
    },
    "verification": {
      "build": "required",
      "tests": "required",
      "lint": "ament_lint_common"
    }
  }
}
